{
  "manifest_version": 3,
  "name": "YouTube Cloud",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "description": "유튜브의 타임스탬프 댓글을 영상 속 해당 순간에 표시합니다.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "optional_host_permissions": ["https://www.googleapis.com/*"],
  "background": {
    "service_worker": "src/api-worker.js"
  },
  "icons": {
    "16": "icons/cloud-16.png",
    "32": "icons/cloud-32.png",
    "48": "icons/cloud-48.png",
    "128": "icons/cloud-128.png"
  },
  "action": {
    "default_title": "YouTube Cloud",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/youtube-comments.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/settings.js", "src/timeline.js", "src/comment-graph.js", "src/api-comments.js", "src/player.js"],
      "css": ["src/tokens.css", "src/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
